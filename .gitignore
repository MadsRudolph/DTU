# ===========================================
# Claude Code local settings (may contain API keys)
# ===========================================
.claude/settings.local.json
.claude/worktrees/

# ===========================================
# Large files (stored in Google Drive instead)
# ===========================================
# These files are managed by Obsidian/scripts/drive-sync/
# Run: python Obsidian/scripts/drive-sync/download.py
# ===========================================

# Documents and presentations
*.pdf
*.pptx
*.ppt
*.docx
*.doc

# Archives
*.zip
*.7z
*.rar
*.tar.gz
*.iso

# Media files
*.mov
*.mp4
*.avi
*.mkv
*.wav
*.mp3

# Simulation and engineering binaries. These are carried by Syncthing, not git
# -- see .stignore. Keeping them out of git is what stops a 30 MB Simulink model
# landing in a commit; a handful of older ones were force-added before this rule
# existed and stay tracked, which is harmless.
*.mw
*.slx
*.mlx
*.mat
*.npz
*.wbk
*.raw
*.vi

# ===========================================
# Syncthing internals (the binaries themselves are ignored above)
# ===========================================
.stfolder/
.stversions/

# ===========================================
# System and editor files
# ===========================================
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# VS Code "Local History" extension — its own nested .git repo, never ours
.history/

# KiCad lock files (created while a project is open in the GUI)
~*.lck

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# ===========================================
# Obsidian (volatile state)
# ===========================================
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/app.json
.obsidian/graph.json

# ===========================================
# Vivado project files (regenerated from TCL scripts)
# ===========================================
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/
*.xpr
*.jou
*.log
*.str
*.bit
*.ltx
*.wdb
*.wcfg
.Xil/
dfx_runtime.txt

# ===========================================
# MATLAB generated figures
# ===========================================
# These are generated by running MATLAB scripts
# Pattern: ex*_*.png (exercise figures)
Obsidian/Courses/*/Images/ex*_*.png

# MATLAB autosave files
*.asv

# ===========================================
# MATLAB pretty.bat publishing artifacts
# ===========================================
3.semester/DSP/EXAMS/html/

# 62768 team product repo (separate git repo, do not nest into umbrella)
4. Semester/Electrical Energy Systems/team/
# 34870 labs: own git repo shared with the lab group and synced with Overleaf (MadsRudolph/34870-electroacoustics-labs)
5. Semester/Electroacoustics/Labs/

# ===========================================
# Block Diagram Reducer Standalone App
# ===========================================
block-diagram-reducer/
Launch-Desktop-App.bat

# Fiberlaser-guide klon (separat repo, kun reference)
4. Semester/Electrical Energy Systems/DTU-PCB-prototyping/

# Nested git repos inside archived course folders — separate repos, never staged here
Obsidian/Archive/4th Semester/62711 Digital Systems Design/PWA Project/Report/
Obsidian/Archive/4th Semester/62711 Digital Systems Design/Report-PWB/
Obsidian/Archive/4th Semester/34655 Integrated Analog Electronics 2/Report/

# Lab A batch-simulation intermediates (regenerated by sim/partN.py)
5. Semester/Electroacoustics/Labs/Lab A/KiCad/*/*_run.cir
5. Semester/Electroacoustics/Labs/Lab A/KiCad/*/*_ac.txt
5. Semester/Electroacoustics/Labs/Lab A/sim/*.npz
5. Semester/Electroacoustics/Labs/Lab A/results/*_log.txt
