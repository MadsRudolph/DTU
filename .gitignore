# ===========================================
# Claude Code local settings (may contain API keys)
# ===========================================
.claude/settings.local.json
.claude/worktrees/

# ===========================================
# Large files (stored in Google Drive instead)
# ===========================================
# These files are managed by Obsidian/scripts/drive-sync/
# Run: python Obsidian/scripts/drive-sync/download.py
# ===========================================

# Documents and presentations
*.pdf
*.pptx
*.ppt
*.docx
*.doc

# Archives
*.zip
*.7z
*.rar
*.tar.gz
*.iso

# Media files
*.mov
*.mp4
*.avi
*.mkv
*.wav
*.mp3

# ===========================================
# System and editor files
# ===========================================
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# ===========================================
# Obsidian (volatile state)
# ===========================================
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/app.json
.obsidian/graph.json

# ===========================================
# Vivado project files (regenerated from TCL scripts)
# ===========================================
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/
*.xpr
*.jou
*.log
*.str
*.bit
*.ltx
*.wdb
*.wcfg
.Xil/
dfx_runtime.txt

# ===========================================
# MATLAB generated figures
# ===========================================
# These are generated by running MATLAB scripts
# Pattern: ex*_*.png (exercise figures)
Obsidian/Courses/*/Images/ex*_*.png

# ===========================================
# Local-only convenience junction
# ===========================================
# Windows directory junction from the 34722 vault path to the regbot
# submodule's docs/ folder, so the regbot notes are browsable alongside
# the other lecture notes in Obsidian. The target's content already
# lives in the REGBOT-Balance-Assignment submodule — don't track it
# through the junction as well.
# Re-create on a fresh clone with:
#   New-Item -ItemType Junction `
#     -Path "Obsidian\Courses\34722 Linear Control Design 1\Exercises\Work\regbot" `
#     -Target "4. Semester\Linear Control Design\REGBOT-Balance-Assignment\docs"
/Obsidian/Courses/34722 Linear Control Design 1/Exercises/Work/regbot
