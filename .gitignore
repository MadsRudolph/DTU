# ===========================================
# Claude Code local settings (may contain API keys)
# ===========================================
.claude/settings.local.json
.claude/worktrees/

# ===========================================
# Large files (stored in Google Drive instead)
# ===========================================
# These files are managed by Obsidian/scripts/drive-sync/
# Run: python Obsidian/scripts/drive-sync/download.py
# ===========================================

# Documents and presentations
*.pdf
*.pptx
*.ppt
*.docx
*.doc

# Archives
*.zip
*.7z
*.rar
*.tar.gz
*.iso

# Media files
*.mov
*.mp4
*.avi
*.mkv
*.wav
*.mp3

# ===========================================
# System and editor files
# ===========================================
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# ===========================================
# Obsidian (volatile state)
# ===========================================
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/app.json
.obsidian/graph.json

# ===========================================
# Vivado project files (regenerated from TCL scripts)
# ===========================================
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/
*.xpr
*.jou
*.log
*.str
*.bit
*.ltx
*.wdb
*.wcfg
.Xil/
dfx_runtime.txt

# ===========================================
# MATLAB generated figures
# ===========================================
# These are generated by running MATLAB scripts
# Pattern: ex*_*.png (exercise figures)
Obsidian/Courses/*/Images/ex*_*.png

# MATLAB autosave files
*.asv

# ===========================================
# MATLAB pretty.bat publishing artifacts
# ===========================================
3.semester/DSP/EXAMS/html/
