# Copy to .env on the container and chmod 600. Never commit the real file.

# Optional. Without these the sync uses the saved browser session only and
# asks you to re-run `learn-sync auth` when it expires.
LEARN_USER=your_username@dtu.dk
LEARN_PASS=

# Where the run reports what it found. Leave empty to disable notifications.
DISCORD_WEBHOOK_URL=

# Brightspace iCal subscription URL, filled in after `learn-sync discover`.
LEARN_CALENDAR_FEED=
