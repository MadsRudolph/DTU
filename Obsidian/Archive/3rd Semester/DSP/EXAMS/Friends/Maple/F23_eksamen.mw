<Input><Text-field style="Text" layout="Normal"><Equation executable="true" style="2D Math" input-equation="" display="LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRicvJStleGVjdXRhYmxlR1EmZmFsc2VGJy8lLG1hdGh2YXJpYW50R1Enbm9ybWFsRic=">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYjLUkjbWlHRiQ2I1EhRic=</Equation></Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block><CodeEditor-ExecGroup view="presentation" inline-output="false" labelreference="L306" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion4" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">Fs = 2000; %sampling frekvens
Ts = 1/Fs; % sampling periode 
fc = 200/Fs; % norm cutoff
wc = fc*2*pi %norm angul\303\246r cutoff
%n vektor til at iterere 
n = [-20:1:20]; 

Ntaps = 25; 

M = Ntaps -1 
K = M/2
nHp = [-K:1:K];

hi_HP = -(wc/pi)*sinc((nHp*wc)/pi); % for n ikke lig 0 

% her er betingelserne p\303\245 n == 0 opfyldt ogs\303\245 
h_ideel = hi_HP;               % g\303\246lder for alle n
h_ideel(nHp==0) = 1 - wc/pi;     % KUN n = 0 rettes

%plotter med n vektor fra n=-20 til 20 
stem(nHp,h_ideel,'lineWidth',0.4,'MarkerSize',4,'MarkerEdgeColor','red')
xlabel(&quot;ntrunk&quot;);
ylabel(&quot;amplitude&quot;)
xlim([-14,14])
ylim([-0.2,1])</EC-CodeEditor></CodeEditor-ExecGroup></Presentation-Block><Presentation-Block>
