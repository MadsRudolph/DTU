% allerede har alle v\303\246rdier skrevet ind vi skal dog have en ny n vektor
% da den skal g\303\245 i de positive v\303\246rdier SP\303\230RG TIL GRUPPEREGNING
n_Black = [0:1:M];
w_Black = 0.42-0.5*cos((2*pi*n_Black)/M)+ 0.08*cos((4*pi*n_Black)/M);

h_w = h_ideel .* w_Black;

stem(n_Black,h_w,'lineWidth',0.4,'MarkerSize',4,'MarkerEdgeColor','red')

% husk her at 12'e element er det h_w(11)
hw11 = h_w(12)
hw14 = h_w(15)
hw17 = h_w(18)
hw20 = h_w(21) 
