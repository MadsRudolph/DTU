</Group></Presentation-Block><Presentation-Block><CodeEditor-ExecGroup view="presentation" inline-output="false" labelreference="L153" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion2" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">%denne kodesnip nedenfor er til at indexere i de valgte punkter
[~, idx30] = min(abs(digfreq - 30));
[~, idx70] = min(abs(digfreq - 70));
[~, idx170] = min(abs(digfreq - 170));
% Hent v\303\246rdierne p\303\245 frekvensresponsen
y30 = abs(H_dig(idx30))
y70 = abs(H_dig(idx70))
y170 = abs(H_dig(idx170))

% denne del kan ogs\303\245 udelades hvis der bare skal findes v\303\246rdier
% Plot punkterne
plot(30, y30, 'ro', 'MarkerSize', 8, 'LineWidth', 1.5)
plot(70, y70, 'ro', 'MarkerSize', 8, 'LineWidth', 1.5)
plot(170, y170, 'ro', 'MarkerSize', 8, 'LineWidth', 1.5)

text(digfreq(idx30), y30, ' attinuation at 30 Hz', 'Color','white', 'FontSize',10);
text(digfreq(idx70), y70, ' attinuation at Fp 70 Hz', 'Color','white', 'FontSize',10);
text(digfreq(idx170), y170, ' attinuation at Fp 170', 'Color','white', 'FontSize',10);
hold off 
hold off
</EC-CodeEditor></CodeEditor-ExecGroup></Presentation-Block><Presentation-Block>
