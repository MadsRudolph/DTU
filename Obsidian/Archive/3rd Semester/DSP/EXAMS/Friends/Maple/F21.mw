</Input>
</Group></Presentation-Block><Presentation-Block><CodeEditor-ExecGroup view="presentation" inline-output="false" labelreference="L88" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion0" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">%IIR h\303\270jpass butter 
Fs = 4000; 
Ts = 1/Fs; 
fs = 700/Fs;
fp = 1200/Fs;
AsdB = 30;
ApdB = 3; 

%vi finder epsilon 
epsilon_i_anden = 10^(0.1*ApdB)-1;

epsilon = sqrt(epsilon_i_anden) 

%epsilon = 0.9976 ---- resultat ---- 

%vi finder ws og wp som er de digitale angul\303\246re frekvenser 
ws = fs*2*pi;
wp = fp*2*pi;

%vi udregner de analoge vinkelfrekvenser: 
Os = (2/Ts)*tan((ws)/2)
Op= (2/Ts)*tan(wp/2)


new = Op/Os


%n_test skal v\303\246re mindre eller lig med n 
n_test = (log10( (  (10^(0.1*AsdB))-1 )    / ((epsilon_i_anden) )))  /( 2*log10(new))

n = ceil(n_test)

% vi skal bruge et 5 ordens filter 

b = [1];
a = [1,3.2361,5.2361,5.2361,3.2361,1]

H_ana = tf(b,a)

%-------------------------------------------------------------------%
%                                    1
% H_ana(z) =  -----------------------------------------------------
%            s^5 + 3.236 s^4 + 5.236 s^3 + 5.236 s^2 + 3.236 s + 1
%-------------------------------------------------------------------%</EC-CodeEditor></CodeEditor-ExecGroup></Presentation-Block><Presentation-Block>
