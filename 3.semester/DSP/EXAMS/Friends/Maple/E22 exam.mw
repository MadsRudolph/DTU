</Group></Presentation-Block><Presentation-Block><CodeEditor-ExecGroup view="presentation" inline-output="false" labelreference="L4735" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion2" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">%FIR b\303\245ndpas filter

Fs = 1000; 
fL = 90/Fs; %norm lav cut freq 
fH = 110/Fs; % norm h\303\270j cut freq
N = 50; 
n = -N:1:N; 
Ts = 1/Fs; 
%vi kan udregne de angul\303\246re normaliserede frekvenser s\303\245ledes
wL = fL*2*pi
wH = fH*2*pi

hideel =  ((wH/pi)*sinc((n*wH)/pi))-((wL/pi)*sinc((n*wL)/pi))

tf(hideel,1,Ts)
stem(n,hideel,'lineWidth',0.4,'MarkerSize',4,'MarkerEdgeColor','red')
%her skal vi huske at det alts\303\245 er 1 der er f\303\270rste element p\303\245 den positive
%side alts\303\245 hiedeel(0)
hideel(51)
hideel(56)
hideel(61)
hideel(66)
</EC-CodeEditor></CodeEditor-ExecGroup></Presentation-Block><Presentation-Block>
