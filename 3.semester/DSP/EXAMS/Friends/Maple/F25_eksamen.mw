</Group></Presentation-Block><Presentation-Block><CodeEditor-ExecGroup view="presentation" inline-output="false" labelreference="L4570" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion2" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">%  2.2 

%for et h\303\270jpas skal vi bruge transformationen: 
 
   %a) 
%for et h\303\270jpas skal vi bruge transformationen: 

%    s-&gt; Opass/s     -- hvor Opass er den  normaliserede analoge pasb\303\245nd frekvens

%    b)    

% vi finder overf\303\270ringsfunktionen: 

[num, den] = lp2hp(b, a, Opass)

HHP = tf(num,den)


%===================================================================%
%             s^4 + 5.773e-12 s^3 + 4.719e-09 s^2 + 0.0003625 s     %
% HHP    = -------------------------------------------------------- %
%          s^4 + 2.09e04 s^3 + 2.185e08 s^2 + 1.338e12 s + 4.096e15 % 
%===================================================================% 


[H_ana_H, anafreq] = freqs(num,den,1024);

plot(anafreq, 20*log10(abs(H_ana_H)))
xline(Ostop,'--r', &quot;Stopband&quot;) % inds\303\246tter en linje for stopb\303\245ndsfrek 
xline(Opass,'--r', &quot;Passband&quot;) % inds\303\246tter en linje for passb\303\245ndsfrek 

xlim([0,10000])
ylim([-40,1])

% det er ret tydeligt at se at vi opfylder kravene   -----resultat-----</EC-CodeEditor></CodeEditor-ExecGroup></Presentation-Block><Presentation-Block>
