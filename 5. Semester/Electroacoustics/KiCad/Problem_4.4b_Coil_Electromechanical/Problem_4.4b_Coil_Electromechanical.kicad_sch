	(text "Problem 4.4b - coil in magnetic field, mechanical side in MOBILITY analogy"
		(at 17.78 10.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "21b95c14-2189-4835-9f35-f695145d1fc1")
	)
	(text "Electrical: V1 = 1 V AC, R1 = Re = 5.0 ohm, L1 = Le = 0.3 mH, E1 = back-EMF = Bl*u (Bl = 2.1 Tm)"
		(at 17.78 15.24 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "3a747997-0c5a-4927-bde7-a809e647c7db")
	)
	(text "Mechanical (u = voltage, f = current): C1 = Mmc = 10 g, L2 = Cms = 1 mm/N, R2 = 1/Rms = 0.5 ohm"
		(at 17.78 19.05 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "0f1c5a68-bae2-466a-8fc3-9d88e7f674ad")
	)
	(text "G1 = f = Bl*i, sensed across Re -> gain Bl/Re = 0.42"
		(at 17.78 22.86 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "b85c4139-6907-4bc4-91f6-b4b8df67fa50")
	)
	(text "Plot: Z_E = V(/vin)/I(V1) -> motional peak ~ Re + Bl^2/Rms = 7.2 ohm at f0 = 50.3 Hz"
		(at 17.78 26.67 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "6f4d4c54-0518-4f72-854e-b41b1ca6f2f9")
	)
