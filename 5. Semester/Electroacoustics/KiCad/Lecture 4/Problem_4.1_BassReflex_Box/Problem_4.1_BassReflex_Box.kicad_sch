	(text "Problem 4.1 - bass reflex box: vent l = 12 cm, D 10 cm, V = 23 l; massless piston driver, same D, velocity u"
		(at 15.24 7.62 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a39347f7-9551-4c42-b304-3a16583e0a68")
	)
	(text "Mechanical (mobility): V1 = u = 1 m/s, G2 = reaction f = S_D*p, S_D = S_v = 0.007854 m^2"
		(at 15.24 12.7 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "7550e14e-be02-4096-a7d0-e4b43bb4a859")
	)
	(text "Front + back carry the same U (series): Z_Af (baffled, a = 5 cm): M_A1 = 6.38, R_A2 = 5.17e+04, R_A1 = 2.28e+04, C_A1 = 5.32e-09"
		(at 15.24 16.51 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "7a57edb0-37e4-41f4-8172-63b4ac4a426b")
	)
	(text "Box: C_A = 1.65e-07 m^5/N; vent: M_Av = rho*l/S = 18 kg/m^4 + same radiation network at pv (DC path is all-inductor)"
		(at 15.24 20.32 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "1848747d-a71e-4004-8ac6-6eeabb34bae3")
	)
	(text "Z_A seen by piston = V(p)/U. Box-port resonance with vent radiation mass: fB = 79 Hz (92 Hz without M_A1). U_vent = I(L2)"
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "6235ccba-8704-400d-9f2b-f757409bab68")
	)
