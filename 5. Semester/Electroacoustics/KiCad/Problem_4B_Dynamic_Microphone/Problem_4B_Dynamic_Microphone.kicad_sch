	(text "Problems 4 / 2a - dynamic pressure microphone (Leach fig. 5.x), 1 Pa in -> V(out) = sensitivity"
		(at 17.78 7.62 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d9b5fb7c-240b-444c-b7fc-1963e8dde995")
	)
	(text "Acoustic (p = V, U = I): V1 = p_i = 1 Pa, L1 = M_A1 = 25.1 kg/m^4 (baffled piston, a = 12.7 mm), R1 = R_AF = 2e+07, C1 = C_AB = 3.58e-11 (V = 5 cm^3), R3 = 1 TOhm DC leak (>> 1/wC_AB even at 10 Hz)"
		(at 17.78 12.7 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "662c33a8-0500-452a-95b4-09dce88fdeeb")
	)
	(text "G1 = diaphragm: U = S_D*u through pf->pb, gain S_D = 0.000507 m^2"
		(at 17.78 16.51 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "256d10cd-6c99-40ed-8f93-f102913d480a")
	)
	(text "Mechanical (mobility, u = V, f = I): G2 = f = S_D*(pf-pb); C2 = M_MD = 0.0002 kg, L2 = C_MS = 0.00021 m/N, R4 = 1/R_MS = 1; G3 = -Bl*i (gain Bl/R_L = 0.000426)"
		(at 17.78 20.32 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "effeaef6-8c15-461e-8f7b-9f8e0633ebc9")
	)
	(text "Electrical: E1 = Bl*u (Bl = 20 Tm), R5 = R_E = 200, R6 = R_L = 47000. Expect band-pass, f0 ~ 1.2 kHz, M ~ -56 dB re 1 V/Pa"
		(at 17.78 24.13 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "864e9233-064a-40f3-a1fc-8f07b6ff71fb")
	)
